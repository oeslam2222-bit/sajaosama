# ============================================================
# Captain Ezz -  كابتن عز  🚖
# Environment variables - نسخة الإنتاج
# ============================================================
# احصل على هذه القيم من لوحة تحكم مشروعك في Supabase:
#   Settings → API → Project URL & anon/public key

# Supabase Project URL (مطلوب)
VITE_SUPABASE_URL="https://-your-project-id.supabase.co"

# Supabase Anon / Public Key (مطلوب)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Gemini AI API key (تُضاف تلقائياً من AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OpenRouteService API key (لحساب المسافات الحقيقية للطرق - اختياري)
VITE_ORS_API_KEY=your_openrouteservice_api_key_here"your_openrouteservice_api_key_here"

# Google Maps API key (لخرائط احترافية - اختياري)
VITE_GOOGLE_MAPS_API_KEY="your_google_maps_api_key_here"

# App hosting URL (يُضاف تلقائياً من AI Studio)
APP_URL="MY_APP_URL"
